class Solution{
public:
    int countPrimes(int n){
        if(n<=2)return 0;
        vector<bool>primeCheck(n,true);
        primeCheck[0]=false;
        primeCheck[1]=false;
        for(int i=2;i*i<n;i++){
            if(primeCheck[i]==true){
                for(int j=i*i;j<n;j+=i){
                    primeCheck[j]=false;
                }
            }
        }
        int total=0;
        for(int i=2;i<n;i++){
            if(primeCheck[i]==true){
                total++;
            }
        }
        return total;
    }
};
