class Solution {
public:
    int subtractProductAndSum(int n) {
        int sum = 0;
        int p = 1;
        while(n>0) {
            int a=n%10;
            int digit=a;
            sum+=digit;
            p*=digit;
            n/=10;
        }
        int ans = p-sum;
        return ans;
    }
};
