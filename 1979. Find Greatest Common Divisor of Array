class Solution {
public:
    int findGCD(vector<int>& nums) {
        int a=nums[0];
        int b=nums[0];
        for(int i=0;i<nums.size();i++){
            if(nums[i]<a) 
                a=nums[i];
            if(nums[i]>b)
                b=nums[i];
        }
        for(int i=a;i>=1;i--){
            if(a%i==0 && b%i==0){
                return i;
            }
        }
        return 1;
    }
};
