#IN C++

class Solution {
public:
    int majorityElement(vector<int>& nums) {
        int count=0;
        int candidate=0;
        for (int num : nums) {
            if (count==0) {
                candidate=num;
                count=1;
            } else if (num==candidate) {
                count++;
            } else {
                count--;
            }
        }
        return candidate;
    }
};

# IN PYTHON

class Solution:
    def majorityElement(self, nums):
        count = 0
        candidate = None
        for num in nums:
            if count == 0:
                candidate = num
                count = 1
            elif num == candidate:
                count += 1
            else:
                count -= 1
        return candidate
